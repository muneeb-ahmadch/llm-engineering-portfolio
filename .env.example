# Required from experiment 07 onward (generation, judging, the agent loop).
# Experiments 01 through 06 are local, CPU only, and need none of this.
OPENAI_API_KEY=sk-proj-...

# Required only for experiment 10 onward (tracing).
# Note: the Langfuse SDK reads LANGFUSE_HOST, not LANGFUSE_BASE_URL.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
